# rinne/.env.example


# Shared
GCP_PROJECT_ID=rinnehackathon
GCP_REGION=asia-southeast1
SERVICE_VERSION=0.1.0-local

# services/web (Next.js)
NODE_ENV=development
PORT=3000
PHYSICS_SERVICE_URL=http://127.0.0.1:8081
AGENT_SERVICE_URL=http://127.0.0.1:8080
RECONSTRUCTION_SERVICE_URL=http://127.0.0.1:8082
GCS_ARTIFACTS_BUCKET=rinne-artifacts-rinnehackathon
HEALTH_TIMEOUT_MS=4000

# A cold L4 needs most of its startup-probe budget before it answers.
RECONSTRUCT_TIMEOUT_MS=240000

# Fixed window, in memory, per instance. The GLOBAL cap protects the credit
# balance; a per-IP cap alone is trivially defeated.
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_PER_IP=6
RATE_LIMIT_GLOBAL=20

NEXT_PUBLIC_APP_NAME=Rinne

# Local development only. On Cloud Run both are minted from the metadata server:
# an ID token authenticates to Cloud Run, an access token authorises the GCS API.
RINNE_DEV_ID_TOKEN=
RINNE_DEV_ACCESS_TOKEN=

# services/physics (Fastify)
PHYSICS_PORT=8081
LOG_LEVEL=info
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000

PHYSICS_ALLOWED_ORIGINS=

# The only bucket physics may read. Belt and braces: the scene contract already
# restricts mesh.uri to gs://, and this restricts WHICH bucket.
GCS_ARTIFACTS_BUCKET=rinne-artifacts-rinnehackathon
MAX_MESH_BYTES=33554432
MESH_FETCH_TIMEOUT_MS=30000

# Local development only. On Cloud Run the token comes from the metadata server.
RINNE_DEV_ACCESS_TOKEN=

# services/agent (FastAPI + ADK)
APP_ENV=development
AGENT_PORT=8080

ENABLE_DOCS=true
MAX_REQUEST_BYTES=1048576

# INGEST. A SEPARATE bucket from the artifacts one, and the split is
# load-bearing: Eventarc can filter a storage trigger by bucket but NOT by
# object prefix, so a trigger on the artifacts bucket would fire on every mesh
# reconstruction writes and the agent would process its own output.
SCAN_BUCKET=rinne-scans-rinnehackathon
SCAN_PREFIX=scan-queue/
MAX_SCAN_BYTES=6291456
OBJECT_TIMEOUT_SECONDS=30

# Section 12's no-unbounded-loops rule, enforced in the Firestore document
# rather than in a counter that dies with the instance. The contract caps
# AgentJob.attempts at 6; config may narrow that, never widen it.
MAX_ATTEMPTS=3

# THE FOUR TEST DOUBLES, all chosen by configuration and never by a runtime
# fallback. A triage that quietly degraded to a canned answer is how a demo
# ends up claiming a model ran when it did not.
#   store_mode=memory   in-process job store with the SAME create-only and
#                       compare-and-swap preconditions Firestore enforces
#   object_mode=memory  returns real PNG bytes instead of reading GCS
#   triage_mode=stub    a deterministic decision, no model call
#   client_mode=memory  canned reconstruction and simulation results, no HTTP
STORE_MODE=firestore
OBJECT_MODE=gcs
TRIAGE_MODE=flash
CLIENT_MODE=http

# Firestore. Enabling the API does NOT create a database; bootstrap-gcp.ps1
# does, in Native mode, and the default database's location is immutable.
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=agent-jobs
FIRESTORE_TIMEOUT_SECONDS=15
FIRESTORE_MAX_ATTEMPTS=3
FIRESTORE_BACKOFF_SECONDS=0.5

# Vertex AI, tier 1. google-genai reads GOOGLE_GENAI_USE_VERTEXAI,
# GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION from the environment; app.py
# sets all three from these values, so they are NOT listed here to be set twice.
VERTEX_LOCATION=asia-southeast1
TRIAGE_MODEL=gemini-3.5-flash
TRIAGE_TEMPERATURE=0.0
TRIAGE_MAX_OUTPUT_TOKENS=512

# ZERO ON PURPOSE, and this one cost a measurement to learn: Gemini 3.5 Flash
# thinks by default and thinking tokens come out of the SAME budget as the
# answer. At 16 output tokens it spent all 16 thinking and returned no content
# at all, with finishReason MAX_TOKENS. Triage is one classification.
TRIAGE_THINKING_BUDGET=0
TRIAGE_TIMEOUT_SECONDS=60

# The two downstream services the agent calls in one request. Both are
# IAM-private, so both are reached with an ID token minted for that exact URL.
# deploy-all.ps1 sets these from the deployed URLs; they are blank here because
# a wrong URL that answers is worse than no URL at all.
RECONSTRUCTION_SERVICE_URL=
PHYSICS_SERVICE_URL=

# 280s is under the agent's own 420s Cloud Run timeout with the rest of the
# loop to spare, and a cold L4 spends most of it starting.
RECONSTRUCTION_TIMEOUT_SECONDS=280
PHYSICS_TIMEOUT_SECONDS=60

# THE DECLARED GATE POLICY, section 7 step 3. The agent escalates rather than
# reports when EITHER confidence falls short, when physics returns
# inconclusive, or when the chosen test is not implemented in the engine.
# Every escalation record names the policy, the threshold and the observed
# value, so a refusal is auditable from the job document alone. Changing a
# number here is an env var; changing WHAT is compared bumps the policy name.
GATE_RECONSTRUCTION_CONFIDENCE=0.70
GATE_MATERIAL_CONFIDENCE=0.50

# SOLVER. services/physics reads every one of these off the scene it is sent,
# so this is the only place they are defined and determinism depends on it.
SOLVER_TIMESTEP_SECONDS=0.016666666666666666
SOLVER_MAX_STEPS=900
SOLVER_SEED=42
GROUND_FRICTION=0.6
GROUND_RESTITUTION=0.1

# Section 0c measured a real hull tipping at 0.51 of its own weight, so the
# push is a RATIO of body weight, not a fixed newton value. A constant force
# is meaningless across masses: it topples a pen and never moves a monitor.
TIP_FORCE_RATIO=0.5
TIP_HEIGHT_RATIO=0.9
TIP_DIRECTION_DEGREES=0.0
TIP_DURATION_SECONDS=0.2
DROP_HEIGHT_METERS=0.1
LOAD_MULTIPLE=2.0

# services/reconstruction (FastAPI on Cloud Run GPU)
RECONSTRUCTION_PORT=8082
# stub locally: the weights and the vendored trees exist only in the image.
#   stub         a deterministic procedural mesh, honest about being one
#   triposr      single-image feed-forward. ~3s, coarse, blobby on thin detail
#   instantmesh  Zero123++ invents six views, an LRM reconstructs from them.
#                Slower and much cleaner. Switching between the two is an env
#                var on a deployed revision, so a bad result rolls back in a
#                minute without a rebuild.
PIPELINE_NAME=stub
STUB_RESOLUTION=64

# All three paths are baked by the Dockerfile; they are here to be read, not set.
TRIPOSR_SOURCE_DIR=/opt/triposr/src
TRIPOSR_WEIGHTS_DIR=/opt/triposr/weights
TRIPOSR_COMMIT_SHA=107cefdc244c39106fa830359024f6a2f1c78871
TRIPOSR_MARCHING_CUBES_RESOLUTION=256
TRIPOSR_CHUNK_SIZE=8192
TRIPOSR_FOREGROUND_RATIO=0.85
SEGMENTATION_MODEL_PATH=/opt/u2netp/u2netp.onnx

# InstantMesh. Baked by the Dockerfile, pinned by upstream commit and by HF
# revision; here to be read, not set. nvdiffrast is deliberately NOT installed:
# lrm.py imports it but only reaches it under use_texture_map=True, which this
# service never asks for, so it is stubbed and the CUDA build disappears.
INSTANTMESH_SOURCE_DIR=/opt/instantmesh/src
INSTANTMESH_WEIGHTS_DIR=/opt/instantmesh/weights
ZERO123PLUS_DIR=/opt/zero123plus
INSTANTMESH_COMMIT_SHA=08822c52fdc399b93ea00e4fa9e596344ed52ccc
INSTANTMESH_MARCHING_CUBES_RESOLUTION=256

# Every step is GPU seconds. Upstream defaults to 75; lower it to trade a little
# view consistency for a shorter request.
INSTANTMESH_DIFFUSION_STEPS=75

# Marching cubes returns the isosurface's own quantisation as surface detail.
# Taubin preserves volume, so smoothing does not quietly change the mass.
MESH_SMOOTHING_ITERATIONS=12

# storage_mode=memory is the test path: it keeps the GLB in-process and still
# reports the gs:// URI it would have written.
STORAGE_MODE=gcs
GCS_OBJECT_PREFIX=meshes

# Section 0b spec appendix. 25 MiB stays under Cloud Run's 32 MiB ceiling.
MAX_REQUEST_BYTES=26214400
MAX_METADATA_CHARS=4096
MAX_IMAGES=4
MAX_IMAGE_BYTES=6291456
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_EDGE=1536

# The full four-component weights. A pipeline that does not segment gets these
# renormalised over three in code, so there is nothing to change here for stub.
CONFIDENCE_WEIGHT_FIELD_DECISIVENESS=0.45
CONFIDENCE_WEIGHT_WATERTIGHTNESS=0.30
CONFIDENCE_WEIGHT_FOREGROUND_QUALITY=0.15
CONFIDENCE_WEIGHT_VOLUME_PLAUSIBILITY=0.10

# UNCALIBRATED until Day 3 measures them against three real objects.
CONFIDENCE_BAND_LOW_MAX=0.45
CONFIDENCE_BAND_HIGH_MIN=0.70
CONFIDENCE_CALIBRATED=false

ASSUMED_LONGEST_DIMENSION_METERS=0.30
SOLID_FRACTION=0.55

# SECRETS
# Stored in Google Secret Manager, mounted at deploy time.
#   SLACK_WEBHOOK_URL      -> secret: rinne-slack-webhook
#   GEMINI_API_KEY         -> not used; Vertex AI uses the runtime SA
