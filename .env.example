# rinne/.env.example


# Shared
GCP_PROJECT_ID=rinnehackathon
GCP_REGION=asia-southeast1
SERVICE_VERSION=0.1.0-local

# services/web (Next.js)
NODE_ENV=development
PORT=3000
PHYSICS_SERVICE_URL=http://127.0.0.1:8081
AGENT_SERVICE_URL=http://127.0.0.1:8080
RECONSTRUCTION_SERVICE_URL=http://127.0.0.1:8082
GCS_ARTIFACTS_BUCKET=rinne-artifacts-rinnehackathon
HEALTH_TIMEOUT_MS=4000

# A cold L4 needs most of its startup-probe budget before it answers.
RECONSTRUCT_TIMEOUT_MS=240000

# Fixed window, in memory, per instance. The GLOBAL cap protects the credit
# balance; a per-IP cap alone is trivially defeated.
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_PER_IP=6
RATE_LIMIT_GLOBAL=20

NEXT_PUBLIC_APP_NAME=Rinne

# Local development only. On Cloud Run both are minted from the metadata server:
# an ID token authenticates to Cloud Run, an access token authorises the GCS API.
RINNE_DEV_ID_TOKEN=
RINNE_DEV_ACCESS_TOKEN=

# services/physics (Fastify)
PHYSICS_PORT=8081
LOG_LEVEL=info
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000

PHYSICS_ALLOWED_ORIGINS=

# services/agent (FastAPI)
APP_ENV=development
AGENT_PORT=8080

ENABLE_DOCS=true
MAX_REQUEST_BYTES=1048576

# services/reconstruction (FastAPI on Cloud Run GPU)
RECONSTRUCTION_PORT=8082
PIPELINE_NAME=stub
STUB_RESOLUTION=64

# storage_mode=memory is the test path: it keeps the GLB in-process and still
# reports the gs:// URI it would have written.
STORAGE_MODE=gcs
GCS_OBJECT_PREFIX=meshes

# Section 0b spec appendix. 25 MiB stays under Cloud Run's 32 MiB ceiling.
MAX_REQUEST_BYTES=26214400
MAX_METADATA_CHARS=4096
MAX_IMAGES=4
MAX_IMAGE_BYTES=6291456
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_EDGE=1536

# Day 2 ships THREE confidence components; these are the renormalised weights.
# volume_plausibility is 0.1177, not 0.1176 - the naive value sums to 0.9999
# and config.py rejects it.
CONFIDENCE_WEIGHT_FIELD_DECISIVENESS=0.5294
CONFIDENCE_WEIGHT_WATERTIGHTNESS=0.3529
CONFIDENCE_WEIGHT_VOLUME_PLAUSIBILITY=0.1177

# UNCALIBRATED until Day 3 measures them against three real objects.
CONFIDENCE_BAND_LOW_MAX=0.45
CONFIDENCE_BAND_HIGH_MIN=0.70
CONFIDENCE_CALIBRATED=false

ASSUMED_LONGEST_DIMENSION_METERS=0.30
SOLID_FRACTION=0.55

# SECRETS
# Stored in Google Secret Manager, mounted at deploy time.
#   SLACK_WEBHOOK_URL      -> secret: rinne-slack-webhook  
#   GEMINI_API_KEY         -> not used; Vertex AI uses the runtime SA 