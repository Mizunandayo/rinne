# rinne/.gitattributes
# LF in the repository, always. The contracts drift check compares generated bytes,
# and a CRLF checkout on Windows against an LF checkout on a Linux CI runner fails it
# for reasons that have nothing to do with the schema.


*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

*.png   binary
*.jpg   binary
*.woff2 binary
*.glb   binary
*.wasm  binary

packages/contracts/src/generated/**            linguist-generated=true
services/agent/src/rinne_agent/contracts/**    linguist-generated=true
pnpm-lock.yaml                                 linguist-generated=true
uv.lock                                        linguist-generated=true