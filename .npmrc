# rinne/.npmrc
engine-strict=true

# Exact versions on every install. Carets are how a lockfile-clean repo still
save-exact=true

prefer-frozen-lockfile=true
auto-install-peers=true
strict-peer-dependencies=false

# Fail fast in CI rather than resolving a fresh dependency graph.
resolution-mode=highest

# Never send package data anywhere but the registry.
update-notifier=false